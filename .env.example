# Copy to .env and fill in. The real .env is gitignored and excluded from the Docker image.

# MongoDB connection (e.g. an Atlas connection string) and database name
MONGODB_URI=
MONGODB_DB=

# Allowed CORS origin (the frontend's URL). Not needed when the frontend proxies /api (docker compose).
ORIGINS=http://localhost:5173

# JWT signing: use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=45
